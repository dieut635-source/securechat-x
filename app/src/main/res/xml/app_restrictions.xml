<!--
  Managed configurations for Android Enterprise / Samsung Knox Manage.

  The four android:key values are the contract with the Knox console. Renaming one does not fail the
  build or the push - it silently reverts that setting to its default on every managed device - so
  they must stay exactly as they are. Keep them in step with
  libraries/mdm/api/.../MdmConfig.kt, which reads them.
-->
<restrictions xmlns:android="http://schemas.android.com/apk/res/android">

    <restriction
        android:key="homeserver_url"
        android:restrictionType="string"
        android:title="@string/mdm_homeserver_url_title"
        android:description="@string/mdm_homeserver_url_description"
        android:defaultValue="https://chat.securechat.com.au" />

    <restriction
        android:key="allow_registration"
        android:restrictionType="bool"
        android:title="@string/mdm_allow_registration_title"
        android:description="@string/mdm_allow_registration_description"
        android:defaultValue="false" />

    <restriction
        android:key="allow_file_send"
        android:restrictionType="bool"
        android:title="@string/mdm_allow_file_send_title"
        android:description="@string/mdm_allow_file_send_description"
        android:defaultValue="true" />

</restrictions>
