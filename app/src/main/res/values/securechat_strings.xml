<!--
  SecureChat rebrand.

  Nearly every inherited string builds the app name from %1$s (app_name), so it rebrands itself.
  These are final application-level overrides for the handful of resource IDs that historically
  hard-coded another product or public server. Module locale files carry matching neutral values.
-->
<resources
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedResources">
    <!-- features/call/impl -->
    <string translatable="false" name="element_call">SecureChat Call</string>
    <string name="screen_incoming_call_subtitle_android">"Incoming call"</string>
    <string name="call_invalid_audio_device_bluetooth_devices_disabled">"Calls do not support using Bluetooth audio devices in this Android version. Please select a different audio device."</string>

    <!-- features/preferences/impl -->
    <string name="screen_advanced_settings_element_call_base_url">"Custom call server URL"</string>
    <string name="screen_advanced_settings_element_call_base_url_description">"Set a custom base URL for calls."</string>
    <string name="screen_notification_settings_sound_element_default">"SecureChat Default"</string>
    <string name="screen_notification_settings_sound_element_fade">"SecureChat Fade"</string>

    <!-- features/messages/impl -->
    <string name="screen_room_timeline_legacy_call">"Unsupported call. Ask if the caller can use the new SecureChat app."</string>

    <!-- libraries/push/impl: neutral fallbacks retained for builds without Google services. -->
    <string name="push_distributor_firebase_android">"System push service"</string>
    <string name="push_no_valid_google_play_services_apk_android">"Background notification services are unavailable. Notifications may be delayed."</string>

    <!-- features/login/impl -->
    <string name="screen_change_server_error_element_pro_required_title">"Unsupported server"</string>
    <string name="screen_change_server_error_element_pro_required_message">"%1$s cannot be used with SecureChat. Please contact your administrator."</string>
    <string name="screen_change_server_error_element_pro_required_action_android">"OK"</string>
    <string name="screen_missing_key_backup_open_element_classic">"Open your previous Matrix app"</string>
    <string name="screen_missing_key_backup_step_1">"Open your previous Matrix app on your device"</string>
    <string name="screen_onboarding_welcome_title">"Welcome to SecureChat"</string>
    <!--
      Câu chào kế thừa là văn quảng cáo của Element: "the fastest %1$s ever. Supercharged
      for speed and simplicity". Với nhân viên được tổ chức phát máy thì "nhanh nhất từ
      trước tới nay" vô nghĩa — họ chưa từng dùng bản nào trước. Và tốc độ không phải thứ
      sản phẩm này bán; thứ nó bán là bí mật cuộc trò chuyện.

      Câu mới còn làm một việc nữa: nói thẳng rằng máy do tổ chức quản lý. Đây là máy có
      Device Owner, và người dùng nên biết điều đó ngay từ màn hình đầu tiên.
    -->
    <string name="screen_onboarding_welcome_message">"%1$s is your organisation\'s private messenger. Messages are end-to-end encrypted, and this device is centrally managed."</string>
    <!--
      Nút cũ ghi nguyên "Sign in to https://chat.securechat.com.au". Người dùng không được
      chọn máy chủ — nó do cấu hình quản lý ấn định — nên in địa chỉ lên nút chỉ là tiếng
      ồn kỹ thuật, và làm nút dài quá khổ. Màn hình kế tiếp vẫn xác nhận rõ máy chủ.
    -->
    <string name="screen_onboarding_sign_in_to">"Sign in"</string>
    <!--
      Phụ đề màn hình đăng nhập vốn là "Matrix is an open network for secure, decentralised
      communication." Sản phẩm gắn nhãn trắng thì người dùng không cần biết công nghệ nền;
      và với người nhặt được máy, câu đó cho biết ngay đang chạy phần mềm gì. Thay bằng câu
      nói cho người dùng biết phải làm gì.
    -->
    <string name="screen_login_subtitle">"Messages are end-to-end encrypted and this device is managed by your organisation. Sign in with the details your administrator gave you."</string>
    <string name="screen_server_confirmation_message_login_matrix_dot_org">"A private server."</string>
    <string name="screen_server_confirmation_message_login_element_dot_io">"A private server."</string>
    <string name="screen_change_account_provider_matrix_org_subtitle">"SecureChat uses a private server managed by your organisation."</string>
    <string name="screen_change_server_textfield_footer_register">"Accounts are created by your administrator. Contact them if you need access."</string>

    <!-- features/startchat/impl -->
    <string name="screen_start_chat_join_room_by_address_supporting_text">"e.g. #team-name:your-server"</string>
</resources>
