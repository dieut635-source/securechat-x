<!--
  SecureChat rebrand.

  Nearly every inherited string builds the app name from %1$s (app_name), so it rebrands itself.
  These are final application-level overrides for the handful of resource IDs that historically
  hard-coded another product or public server. Module locale files carry matching neutral values.
-->
<resources
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedResources">
    <!-- features/call/impl -->
    <string translatable="false" name="element_call">SecureChat Call</string>
    <string name="screen_incoming_call_subtitle_android">"Incoming call"</string>
    <string name="call_invalid_audio_device_bluetooth_devices_disabled">"Calls do not support using Bluetooth audio devices in this Android version. Please select a different audio device."</string>

    <!-- features/preferences/impl -->
    <string name="screen_advanced_settings_element_call_base_url">"Custom call server URL"</string>
    <string name="screen_advanced_settings_element_call_base_url_description">"Set a custom base URL for calls."</string>
    <string name="screen_notification_settings_sound_element_default">"SecureChat Default"</string>
    <string name="screen_notification_settings_sound_element_fade">"SecureChat Fade"</string>

    <!-- features/messages/impl -->
    <string name="screen_room_timeline_legacy_call">"Unsupported call. Ask if the caller can use the new SecureChat app."</string>

    <!-- features/login/impl -->
    <string name="screen_change_server_error_element_pro_required_title">"Unsupported server"</string>
    <string name="screen_change_server_error_element_pro_required_message">"%1$s cannot be used with SecureChat. Please contact your administrator."</string>
    <string name="screen_missing_key_backup_open_element_classic">"Open your previous Matrix app"</string>
    <string name="screen_missing_key_backup_step_1">"Open your previous Matrix app on your device"</string>
    <string name="screen_onboarding_welcome_title">"Welcome to SecureChat"</string>
    <string name="screen_server_confirmation_message_login_element_dot_io">"A private server."</string>
    <string name="screen_change_account_provider_matrix_org_subtitle">"SecureChat uses a private server at chat.securechat.com.au for secure communication."</string>
    <string name="screen_change_server_textfield_footer_register">"Create a SecureChat account on chat.securechat.com.au. Contact your administrator if you need access."</string>

    <!-- features/startchat/impl -->
    <string name="screen_start_chat_join_room_by_address_supporting_text">"e.g. #room-name:chat.securechat.com.au"</string>
</resources>
