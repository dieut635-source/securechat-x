<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Preview and component-catalog activities are development tooling, not production UI. -->
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <activity
            android:name="com.airbnb.android.showkase.ui.ShowkaseBrowserActivity"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!-- ADB/shell callers hold android.permission.DUMP. Remove diagnostic broadcast surfaces
             from production so a workstation used for sideloading cannot request work metadata or
             trigger profile-management operations after installation. -->
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />
        <!-- androidx.profileinstaller is not a dependency of the F-Droid variant, so lint reports
             MissingClass for this name. The removal stays as a guard in case the library is ever
             pulled in transitively: deleting it would silently ship the receiver at that point. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>

</manifest>
